{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "regions": ["pdx1"],
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin"
      },
      "continue": true
    },
    {
      "src": "^/modelos/.+\\.glb$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/app\\.[0-9a-f]{10}\\.js$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/images/poster-[a-z0-9-]+(\\.1440)?\\.(avif|webp)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/assets/textures/[a-z0-9-]+\\.[0-9a-f]{10}\\.webp$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/(index\\.html)?$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp/|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|Pinterestbot|redditbot|Embedly|Cardyb|vkShare|Iframely).*"
        }
      ],
      "dest": "/api/compartir"
    }
  ]
}
